{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConversationMemoryRuntime",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:580064884025:table/company-chat-memory"
    },
    {
      "Sid": "ConversationMemorySetup",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:CreateTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:580064884025:table/company-chat-memory"
    }
  ]
}

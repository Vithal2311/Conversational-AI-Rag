# Copy to .env locally. Never put real credentials in this template.
# Loading .env will be implemented in the configuration step.
APP_ENV=development
AWS_DEFAULT_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only when using temporary AWS credentials.
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=
S3_PREFIX=
DYNAMODB_TABLE_NAME=company-chat-memory
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_CHAT_MODEL=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=development
